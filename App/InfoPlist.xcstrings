    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "RingoMate uses this to find the Ghostty or iTerm2 window running Claude Code so it can sit on top of it, and to mention the song playing in Music or Spotify. Nothing leaves your Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code が動いている Ghostty・iTerm2 のウィンドウを探して、その上に座るためと、ミュージック・Spotify で聴いている曲を一言の話題にするために使います（Mac の外へは出しません）。"
          }
        }
      }
    }
  },
  "version" : "1.0"
